{
  "compilerOptions": {
    "target": "ES2017",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": false,
    "experimentalDecorators": true,
    "esModuleInterop": false,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "noEmitOnError": false,
    "outDir": "../../temp/headless-build",
    "rootDir": "../..",
    "baseUrl": ".",
    "paths": {
      "cc": ["./cc-stub.d.ts"]
    },
    "types": []
  },
  "include": [
    "../../assets/Script/game/**/*.ts",
    "../../assets/Script/core/**/*.ts",
    "./cc-stub.d.ts"
  ],
  "exclude": [
    "../../assets/Script/GameLaunch.ts",
    "../../assets/Script/UI/**"
  ]
}
